[Unit]
Description=StopNulis Telegram Handwriting Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stopnulis
Group=stopnulis
WorkingDirectory=/home/stopnulis/app
EnvironmentFile=/home/stopnulis/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/stopnulis/app/.venv/bin/python /home/stopnulis/app/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
